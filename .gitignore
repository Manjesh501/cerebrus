# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment secrets — NEVER commit
.env

# Logs
*.log

# Upload/result runtime directories (user data, not source)
uploads/
results/
batch_uploads/
batch_results/
# Keep the placeholder files so the dirs exist after clone
!uploads/.gitkeep
!results/.gitkeep
!batch_uploads/.gitkeep
!batch_results/.gitkeep

# Large binary assets — use Git LFS for these
docs/demo.mp4

# Jupyter
.ipynb_checkpoints/

# Distribution / packaging
build/
dist/
*.egg-info/

# Testing
.pytest_cache/
.coverage
htmlcov/

# IDEs
.idea/
.vscode/
*.swp
*.swo

# macOS
.DS_Store

# Model files (large binaries — track with Git LFS instead)
ML_model/*.pkl


# Threat intelligence DB (runtime state)
threat_intel.db